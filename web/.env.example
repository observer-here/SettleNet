# Arc Testnet RPC (optional — defaults to public RPC)
VITE_RPC_URL=https://rpc.testnet.arc.network

# Chain id (optional — defaults to 5042002)
VITE_CHAIN_ID=5042002

# ArcScan indexer API (optional)
VITE_ARCSCAN_API=https://testnet.arcscan.app/api/v2

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Arc faucet (optional)
VITE_FAUCET_URL=https://faucet.circle.com

# Contract addresses (required after redeploy)
VITE_USDC_ADDRESS=
VITE_IDENTITY_ADDRESS=
VITE_SETTLENET_ADDRESS=
VITE_EVALUATOR_STAKE_ADDRESS=
VITE_PROVIDER_BOND_ADDRESS=
